# =============================================================================
# Backend de Emergencias 168 - PRODUCCION
# =============================================================================
# Copia este archivo como `.env` en el servidor y sustituye los valores que
# empiezan por COLOCA_AQUI_. Ese prefijo marca todo lo que debes cambiar antes
# de arrancar; si queda alguno sin sustituir, el servicio no es seguro.
#
# Comprobacion rapida antes de arrancar:
#   grep COLOCA_AQUI_ .env        <- no debe devolver ninguna linea
# =============================================================================

NODE_ENV=production
# El puerto es interno: nginx recibe el 443 y lo reenvia aqui.
PORT=8080
TZ=America/La_Paz

# Solo el panel administrativo puede llamar a esta API desde un navegador.
# Sin esto, cualquier sitio web podria usar la sesion de un operador.
CORS_ORIGIN=https://central.sedesoruro.gob.bo

# En produccion el registro de peticiones lo lleva nginx; dejarlo aqui duplica
# el trabajo y llena el disco.
HTTP_LOGGING=false

# -----------------------------------------------------------------------------
# Base de datos
# -----------------------------------------------------------------------------
DB_DIALECT=mysql
DB_HOST=181.115.157.166
DB_PORT=4444
DB_NAME=central-db
DB_USER=root
DB_PASSWORD=COLOCA_AQUI_LA_CONTRASENA_DE_MYSQL
DB_LOGGING=false

# -----------------------------------------------------------------------------
# Tokens de sesion
# -----------------------------------------------------------------------------
# Genera uno nuevo y unico, nunca el de desarrollo. Con la clave de ejemplo
# cualquiera puede fabricar tokens validos y entrar como cualquier usuario:
#   openssl rand -base64 48
JWT_SECRET=COLOCA_AQUI_UNA_CLAVE_LARGA_Y_ALEATORIA
JWT_ISSUER=https://api-central.sedesoruro.gob.bo
JWT_EXPIRES_IN=15m
JWT_REFRESH_DAYS=30

# -----------------------------------------------------------------------------
# Archivos subidos (evidencias de emergencias)
# -----------------------------------------------------------------------------
# Ruta en disco del servidor. Debe estar fuera de la carpeta del codigo para que
# un redespliegue no borre las evidencias ya subidas.
STORAGE_LOCAL_DIR=/var/lib/emergencias168/uploads
STORAGE_PUBLIC_URL=https://api-central.sedesoruro.gob.bo/api/storage/file
