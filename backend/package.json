{
  "name": "emergencias-168-backend",
  "version": "1.0.0",
  "main": "build/server.js",
  "scripts": {
    "dev": "tsc-watch --onSuccess \"node build/server.js\"",
    "build": "tsc",
    "start": "node build/server.js",
    "version-major": "npm version major",
    "version-minor": "npm version minor",
    "version-patch": "npm version patch",
    "create-database": "npm run build && cross-env CREATE_DATABASE=true node build/server.js",
    "lint": "oxlint src",
    "eslint": "npm run lint",
    "format": "prettier --write \"src/**/*.{ts,tsx,scss,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,scss,css,json}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mime-types": "^3.0.2",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "mysql2": "^3.23.2",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mime-types": "^3.0.1",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.2",
    "cross-env": "^10.1.0",
    "oxlint": "^1.76.0",
    "prettier": "^3.9.6",
    "tsc-watch": "^7.2.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
