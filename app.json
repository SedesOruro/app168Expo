{
  "expo": {
    "name": "Emergencias 168",
    "slug": "emergencias-168",
    "scheme": "emergencias168",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "bo.gob.emergencias168",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "bo.gob.emergencias168",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CALL_PHONE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./src/shared/assets/fonts/WorkSans-Regular.ttf",
            "./src/shared/assets/fonts/WorkSans-Medium.ttf",
            "./src/shared/assets/fonts/WorkSans-SemiBold.ttf",
            "./src/shared/assets/fonts/WorkSans-Bold.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permitir que Emergencias 168 use su ubicacion para reportar y localizar una emergencia."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir que Emergencias 168 acceda a imagenes de evidencia.",
          "cameraPermission": "Permitir que Emergencias 168 tome fotografias de evidencia.",
          "microphonePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Permitir que Emergencias 168 grabe audio de evidencia."
        }
      ],
      "expo-asset",
      "@maplibre/maplibre-react-native",
      "@react-native-community/datetimepicker",
      "./plugins/withFirmaRelease",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["arm64-v8a", "armeabi-v7a"],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ]
  }
}
