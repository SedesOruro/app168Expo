# =============================================================================
# Panel administrativo de Emergencias 168 - PRODUCCION
# =============================================================================
# Copia este archivo como `.env.production` antes de `npm run build`.
#
# Ojo: Vite incrusta estas variables en el JavaScript que se descarga el
# navegador. Aqui no va ningun secreto, solo direcciones publicas.
# =============================================================================

VITE_API_URL=https://api-central.sedesoruro.gob.bo/api
VITE_STORAGE_URL=https://api-central.sedesoruro.gob.bo/api/storage/file

# Nombre de la clave donde el navegador guarda el token de sesion del operador.
VITE_TOKEN_KEY=auth_token

# Solo si usas el editor enriquecido. Dejalo vacio si no lo necesitas.
VITE_EDITOR_API_KEY=
