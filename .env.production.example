# =============================================================================
# Aplicacion movil de Emergencias 168 - PRODUCCION
# =============================================================================
# Copia este archivo como `.env` antes de compilar el APK de release.
#
# Estas direcciones van por HTTPS a proposito. Android bloquea el trafico en
# claro en las compilaciones de produccion, asi que un `http://` aqui deja la
# aplicacion sin poder hablar con la Central.
# =============================================================================

EXPO_PUBLIC_API_URL=https://api-central.sedesoruro.gob.bo/api
EXPO_PUBLIC_SOCKET_URL=https://api-central.sedesoruro.gob.bo

# Estilo del mapa. Servicio publico de teselas, no requiere clave.
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
